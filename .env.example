# Copy to .env (local) or set in the Vercel / Netlify dashboard. Server-side only — never add a VITE_ prefix.

# Telegram: create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional journal in Supabase (run server/requests.sql once). Use the service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_REQUESTS_TABLE=fragrance_requests

# Layering atelier (public values — safe in the browser; RLS protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The model key lives in Supabase secrets, not here:  npx supabase secrets set OPENROUTER_API_KEY=...
