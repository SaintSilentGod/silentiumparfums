// Regenerates supabase/functions/layering/silentium.ts from client/src/lib/perfumes.ts
// Run after editing perfumes:  npx tsx scripts/sync-silentium.mts
import { writeFileSync } from "node:fs";
import { perfumes } from "../client/src/lib/perfumes.ts";

const notes = (p: (typeof perfumes)[number]) => {
  const n = p.scentNotes;
  if (n.all) return { all: n.all.en };
  return { top: n.top?.en ?? [], heart: n.heart?.en ?? [], base: n.base?.en ?? [] };
};
const data = perfumes.map((p) => ({ id: p.id, name: p.name, emotions: p.emotionalPath, tagline: p.tagline.en, notes: notes(p), keywords: p.keywords.en }));
writeFileSync(
  new URL("../supabase/functions/layering/silentium.ts", import.meta.url),
  `// Generated by scripts/sync-silentium.mts — do not edit by hand.\nexport const SILENTIUM = ${JSON.stringify(data, null, 2)} as const;\n`,
);
console.log(`wrote ${data.length} perfumes`);
